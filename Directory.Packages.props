<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Core" Version="1.65.0" />
    <PackageVersion Include="JetBrains.Profiler.Api" Version="1.4.14" />
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Bcl.Cryptography" Version="11.0.0" />
    <PackageVersion Include="Microsoft.DiaSymReader" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="11.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="NuGet.Common" Version="8.0.0" />
    <PackageVersion Include="NuGet.Configuration" Version="8.0.0" />
    <PackageVersion Include="NuGet.Credentials" Version="8.0.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="8.0.0" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <PackageVersion Include="NuGet.Resolver" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.Abstractions" Version="1.2.0" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.FileSystem" Version="1.2.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="JetBrains.dotCover.Framework" Version="1.0.2" />
  </ItemGroup>
</Project>